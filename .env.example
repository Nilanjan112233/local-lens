# Copy to .env and fill in only what you need. .env is git-ignored.
# With no keys at all, LocalLens runs in demo mode with fictional businesses.

# --- Google Places (live discovery) ---------------------------------------
# Enable "Places API (New)" in Google Cloud, restrict the key to that API,
# and set a Cloud quota. The key stays on the server.
GOOGLE_PLACES_API_KEY=

# --- Gemini (verification, analysis, outreach drafts) ----------------------
# Optional override. When omitted, LocalLens reads the encrypted Gemini
# provider configured in a local NovelForge MongoDB (see README).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
NOVELFORGE_MONGODB_URL=mongodb://127.0.0.1:27017
NOVELFORGE_DATABASE_NAME=novelforge
# NOVELFORGE_SETTINGS_KEY_FILE=C:\Users\you\.novelforge\settings.key

# --- API server ------------------------------------------------------------
PORT=8787
# HOST=127.0.0.1
# Comma-separated browser origins allowed to call the API.
# LOCALLENS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# When set, every API route except /api/health requires the
# X-LocalLens-Token header. The Vite dev proxy adds it automatically.
# LOCALLENS_API_TOKEN=
# Where the SQLite database and backups live (default: ./data).
# LOCALLENS_DATA_DIR=data

# --- PDF export --------------------------------------------------------------
# Optional Python interpreter override. Python must have reportlab installed.
# PDF_PYTHON=C:\Path\To\python.exe
