# Enable Places API (New) in Google Cloud for live searches.
GOOGLE_PLACES_API_KEY=
PORT=8787

# Optional override. When omitted, LocalLens securely reads the encrypted
# Gemini provider configured in the local NovelForge MongoDB.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
NOVELFORGE_MONGODB_URL=mongodb://127.0.0.1:27017
NOVELFORGE_DATABASE_NAME=novelforge
# NOVELFORGE_SETTINGS_KEY_FILE=C:\Users\you\.novelforge\settings.key

# Optional PDF interpreter override. Python must have reportlab installed.
# PDF_PYTHON=C:\Path\To\python.exe
